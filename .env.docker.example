# Copy this file to `.env` next to docker-compose.yml and fill in real values.
# `.env` is read automatically by `docker compose` — do not commit it.

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Trust the reverse proxy's Host/X-Forwarded-* headers. Keep "true" unless
# you're exposing the container directly without a proxy in front of it.
AUTH_TRUST_HOST=true

# Optional. Host port to publish the app on (container always listens on 3000).
APP_PORT=3000
